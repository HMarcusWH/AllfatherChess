{
  "schema_version": 2,
  "mode": "shadow",
  "anchor": "stockfish-anchor",
  "root": "..",
  "shadow": {
    "owners": [
      "stockfish",
      "reckless",
      "lc0"
    ],
    "instance_by_owner": {
      "stockfish": "stockfish-shadow",
      "reckless": "reckless-shadow",
      "lc0": "lc0-shadow"
    },
    "oracle": "stockfish-shadow",
    "partition": "root_index_modulo",
    "dispatch_limit": {
      "nodes": 2000
    },
    "lc0_score_type": "WDL_mu",
    "replay_root": "build/replays-strength",
    "oracle_timeout_s": 10,
    "drain_timeout_s": 5,
    "on_anchor_complete": "drain"
  },
  "instances": {
    "stockfish-anchor": {
      "family": "stockfish",
      "role": "anchor",
      "binary": "engines/stockfish/src/stockfish",
      "cwd": ".",
      "args": [],
      "options": {
        "Threads": 1,
        "Hash": 16,
        "MultiPV": 1,
        "UCI_Chess960": false
      }
    },
    "stockfish-shadow": {
      "family": "stockfish",
      "role": "shadow",
      "binary": "engines/stockfish/src/stockfish",
      "cwd": ".",
      "args": [],
      "options": {
        "Threads": 1,
        "Hash": 16,
        "MultiPV": 3,
        "UCI_Chess960": false
      }
    },
    "reckless-shadow": {
      "family": "reckless",
      "role": "shadow",
      "binary": "engines/reckless/target/release/reckless",
      "cwd": ".",
      "args": [],
      "options": {
        "Threads": 1,
        "Hash": 16,
        "MultiPV": 3,
        "Minimal": false,
        "UCI_Chess960": false
      }
    },
    "lc0-shadow": {
      "family": "lc0",
      "role": "shadow",
      "binary": "engines/lc0/build/release/lc0",
      "fallback_glob": "engines/lc0/build/**/lc0",
      "cwd": ".",
      "args": [],
      "options": {
        "WeightsFile": "build/artifacts/lc0/791556.pb.gz",
        "Backend": "blas",
        "BackendOptions": "",
        "NNCacheSize": 0,
        "MinibatchSize": 32,
        "MaxConcurrentSearchers": 1,
        "TaskWorkers": 0,
        "MultiPV": 3,
        "UCI_Chess960": false,
        "Threads": 1,
        "ScoreType": "WDL_mu"
      }
    }
  },
  "verification": {
    "enabled": true,
    "nomination_method": "owner_bestmove_union_v1",
    "dispatch_limit": {
      "nodes": 256
    }
  },
  "refinement": {
    "enabled": true,
    "nomination_method": "verify_final_disagreement_union_v1",
    "child_partition": "child_index_modulo",
    "dispatch_limit": {
      "nodes": 256
    },
    "max_targets": 3,
    "recursive_nomination_method": "stage_terminal_bestmove_v1",
    "max_depth": 2,
    "max_expansions": 3
  },
  "crossfeed": {
    "enabled": true,
    "policy": "typed_verify_refine_v1"
  },
  "counterfactual": {
    "enabled": true,
    "policy": "unanimous_verify_v1"
  },
  "resource_measurement": {
    "enabled": true,
    "provider": "linux-procfs-v1",
    "require_cpu_for_claim": true,
    "require_gpu_for_claim": false,
    "record_memory": true
  }
}
