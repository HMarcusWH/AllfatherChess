{
  "schema_version": 2,
  "mode": "shadow",
  "anchor": "stockfish-anchor",
  "root": "..",
  "shadow": {
    "owners": [
      "stockfish",
      "reckless",
      "lc0"
    ],
    "instance_by_owner": {
      "stockfish": "stockfish-shadow",
      "reckless": "reckless-shadow",
      "lc0": "lc0-shadow"
    },
    "oracle": "stockfish-shadow",
    "partition": "root_index_modulo",
    "dispatch_limit": {
      "nodes": 20000
    },
    "lc0_score_type": "centipawn",
    "replay_root": "build/replays",
    "oracle_timeout_s": 10.0,
    "drain_timeout_s": 5.0,
    "on_anchor_complete": "drain"
  },
  "instances": {
    "stockfish-anchor": {
      "family": "stockfish",
      "role": "anchor",
      "binary": "engines/stockfish/src/stockfish",
      "cwd": ".",
      "args": [],
      "options": {
        "Threads": 1,
        "Hash": 16,
        "MultiPV": 1,
        "UCI_Chess960": false
      }
    },
    "stockfish-shadow": {
      "family": "stockfish",
      "role": "shadow",
      "binary": "engines/stockfish/src/stockfish",
      "cwd": ".",
      "args": [],
      "options": {
        "Threads": 1,
        "Hash": 16,
        "MultiPV": 1,
        "UCI_Chess960": false
      }
    },
    "reckless-shadow": {
      "family": "reckless",
      "role": "shadow",
      "binary": "engines/reckless/target/release/reckless",
      "cwd": ".",
      "args": [],
      "options": {
        "Threads": 1,
        "Hash": 16,
        "MultiPV": 1,
        "Minimal": false,
        "UCI_Chess960": false
      }
    },
    "lc0-shadow": {
      "family": "lc0",
      "role": "shadow",
      "binary": "engines/lc0/build/release/lc0",
      "fallback_glob": "engines/lc0/build/**/lc0",
      "cwd": ".",
      "args": [],
      "options": {
        "WeightsFile": "",
        "Backend": "random",
        "BackendOptions": "seed=20260920",
        "NNCacheSize": 0,
        "MinibatchSize": 1,
        "MaxConcurrentSearchers": 1,
        "TaskWorkers": 0,
        "MultiPV": 1,
        "UCI_Chess960": false,
        "Threads": 1
      }
    }
  }
}
