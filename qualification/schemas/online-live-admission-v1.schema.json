{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:allfather:online-live-admission-v1",
  "title": "Operator-signed runtime admission; never source-controlled",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_commit",
    "source_tree",
    "image_digest",
    "policy_sha256",
    "host_id",
    "host_digest",
    "owner_bot",
    "opponent_bot",
    "session_nonce",
    "not_before_utc",
    "expires_at_utc",
    "max_games",
    "legal_review_digest",
    "operator_approval_id",
    "signature_b64"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "host_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9._-]+$"
    },
    "host_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner_bot": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{2,30}$"
    },
    "opponent_bot": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{2,30}$"
    },
    "session_nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{32,64}$"
    },
    "not_before_utc": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "max_games": {
      "const": 1
    },
    "legal_review_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operator_approval_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]{12,80}$"
    },
    "signature_b64": {
      "type": "string",
      "minLength": 80,
      "maxLength": 96
    }
  }
}
