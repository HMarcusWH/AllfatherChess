# Standalone LOCAL-1 entry point; production engine logic is unchanged.
.PHONY: test source-test-fastchess build-fastchess build qualification soak soak-shard soak-aggregate qualification-v2 soak-v2 soak-shard-v2 soak-aggregate-v2 verify

V2_POLICY := qualification/local-full-game-v2.json

test:
	python3 -c 'import chess; assert chess.__version__ == "1.11.2"'
	python3 -m unittest discover -s tests/local_game -v

# Upstream Fastchess source tests. The reference CI runs this on Ubuntu 22.04
# and carries the resulting identity-bound attestation into the lifecycle job.
source-test-fastchess:
	python3 -m tools.local_game.build_fastchess 		--source-test-only 		--attestation build/fastchess-source-test/attestation.json

build-fastchess:
	python3 -m tools.local_game.build_fastchess

build: build-fastchess
	$(MAKE) build-online-cpu-reference

qualification: test build
	python3 -m tools.local_game.runner --mode required

# Serial local reproduction of the complete engineering soak.
soak: test build
	python3 -m tools.local_game.runner --mode soak

# Reproduce one bounded CI soak shard, e.g. SHARD=0 SHARDS=10.
soak-shard: test build
	@test -n "$(SHARD)" -a -n "$(SHARDS)" || 		(echo 'Set SHARD=<zero-based-index> SHARDS=<count>' >&2; exit 2)
	python3 -m tools.local_game.runner --mode soak 		--shard-index "$(SHARD)" --shard-count "$(SHARDS)"

soak-aggregate:
	@test -n "$(SHARD_ROOT)" || 		(echo 'Set SHARD_ROOT=<directory-containing-downloaded-shard-artifacts>' >&2; exit 2)
	python3 -m tools.local_game.aggregate_soak "$(SHARD_ROOT)" 		--output build/test-results/local-full-game-soak-aggregate/report.json

verify:
	@test -n "$(CAMPAIGN)" || 		(echo 'Set CAMPAIGN=build/test-results/local-full-game/<id>' >&2; exit 2)
	python3 -m tools.local_game.validate "$(CAMPAIGN)"

qualification-v2: test build-fastchess
	@test -n "$(EXECUTION_DOMAIN)" || (echo 'Set EXECUTION_DOMAIN=<path>' >&2; exit 2)
	$(MAKE) build-online-engine-opt-v2
	python3 -m tools.local_game.runner --mode required --policy $(V2_POLICY) --execution-domain "$(EXECUTION_DOMAIN)"

soak-v2: test build-fastchess
	@test -n "$(EXECUTION_DOMAIN)" || (echo 'Set EXECUTION_DOMAIN=<path>' >&2; exit 2)
	$(MAKE) build-online-engine-opt-v2
	python3 -m tools.local_game.runner --mode soak --policy $(V2_POLICY) --execution-domain "$(EXECUTION_DOMAIN)"

soak-shard-v2: test build-fastchess
	@test -n "$(SHARD)" -a -n "$(SHARDS)" -a -n "$(EXECUTION_DOMAIN)" || (echo 'Set SHARD=<zero-based-index> SHARDS=<count> EXECUTION_DOMAIN=<path>' >&2; exit 2)
	python3 -m tools.local_game.runner --mode soak --policy $(V2_POLICY) --execution-domain "$(EXECUTION_DOMAIN)" --shard-index "$(SHARD)" --shard-count "$(SHARDS)"

soak-aggregate-v2:
	@test -n "$(SHARD_ROOT)" || (echo 'Set SHARD_ROOT=<directory-containing-downloaded-shard-artifacts>' >&2; exit 2)
	python3 -m tools.local_game.aggregate_soak "$(SHARD_ROOT)" --policy $(V2_POLICY) --output build/test-results/local-full-game-v2-soak-aggregate/report.json

.PHONY: meta1-tests meta1-run meta1-validate

meta1-tests:
	python3 -m unittest tests.controller.test_meta1_anchor_control tests.meta1.test_contracts tests.meta1.test_integrity

meta1-run:
	python3 -m tools.meta1.runner --j12-report build/test-results/engine-opt-v2-profile-domain/j12/report.json --output build/test-results/meta1/campaign

meta1-validate:
	python3 scripts/qualify-meta-1.py --campaign build/test-results/meta1/campaign
